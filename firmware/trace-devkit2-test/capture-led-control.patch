+// TRACE capture indicator protocol v1. Separate service appended after existing
+// registrations preserves existing audio/battery attribute handles.
+static atomic_t trace_capture_active;
+bool trace_capture_is_active(void) { return atomic_get(&trace_capture_active) != 0; }
+static ssize_t trace_capture_read(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                 void *buf, uint16_t len, uint16_t offset)
+{
+    uint8_t value = trace_capture_is_active() ? 1 : 0;
+    return bt_gatt_attr_read(conn, attr, buf, len, offset, &value, sizeof(value));
+}
+static ssize_t trace_capture_write(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                                  const void *buf, uint16_t len, uint16_t offset, uint8_t flags)
+{
+    if (offset) return BT_GATT_ERR(BT_ATT_ERR_INVALID_OFFSET);
+    if (len != 1) return BT_GATT_ERR(BT_ATT_ERR_INVALID_ATTRIBUTE_LEN);
+    uint8_t value = ((const uint8_t *)buf)[0];
+    if (value > 1 || (flags & BT_GATT_WRITE_FLAG_PREPARE))
+        return BT_GATT_ERR(BT_ATT_ERR_VALUE_NOT_ALLOWED);
+    atomic_set(&trace_capture_active, value);
+    LOG_INF("TRACE capture indicator: %s", value ? "active blue" : "paused amber");
+    return len;
+}
