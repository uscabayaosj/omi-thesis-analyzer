 void mic_off()
 {
-    nrfy_gpio_pin_clear(PDM_PWR_PIN);
+    atomic_clear(&power_allowed);
 }
 
 void mic_on()
 {
+    atomic_set(&power_allowed, 1);
+}
+
+void mic_set_capture_active(bool active)
+{
+    atomic_set(&capture_requested, active);
+}
+
+void mic_process_state(void)
+{
+    if (!initialized) {
+        return;
+    }
+    bool wanted = atomic_get(&capture_requested) && atomic_get(&power_allowed);
+
+    if (!wanted && atomic_get(&accepting_pcm)) {
+        // STOPPED returns partially filled buffers: never encode those as audio.
+        atomic_clear(&accepting_pcm);
+        nrfx_err_t err = nrfx_pdm_stop();
+        if (err != NRFX_SUCCESS) {
+            LOG_ERR("PDM stop failed: %d", err);
+            atomic_set(&accepting_pcm, 1); // Retry on the next main-loop pass.
+            return;
+        }
+        stopping = true;
+    }
+    if (stopping) {
+        // The driver's STOPPED interrupt clears buffers before disabling PDM.
+        // Do not restart or release our clock reference until it has completed.
+        if (NRF_PDM->ENABLE != 0) {
+            return;
+        }
+        stopping = false;
+        nrfy_gpio_pin_clear(PDM_PWR_PIN);
+        LOG_INF("Audio microphone stopped for standby");
+    }
+    if (!wanted) {
+        if (clock_requested) {
+            onoff_cancel_or_release(clock_manager, &clock_client);
+            clock_requested = false;
+        }
+        return;
+    }
+    if (atomic_get(&accepting_pcm)) {
+        return;
+    }
+    if (!clock_requested) {
+        sys_notify_init_spinwait(&clock_client.notify);
+        int err = onoff_request(clock_manager, &clock_client);
+        if (err < 0) {
+            LOG_ERR("PDM clock request failed: %d", err);
+            return;
+        }
+        clock_requested = true;
+    }
+    int clock_result;
+    if (sys_notify_fetch_result(&clock_client.notify, &clock_result) < 0) {
+        return; // Clock startup is asynchronous; keep Bluetooth responsive.
+    }
+    if (clock_result < 0) {
+        onoff_cancel_or_release(clock_manager, &clock_client);
+        clock_requested = false;
+        LOG_ERR("PDM clock startup failed: %d", clock_result);
+        return;
+    }
     nrfy_gpio_pin_set(PDM_PWR_PIN);
+    k_msleep(1);
+    _next_buffer_index = 0;
+    atomic_set(&accepting_pcm, 1);
+    nrfx_err_t err = nrfx_pdm_start();
+    if (err != NRFX_SUCCESS) {
+        atomic_clear(&accepting_pcm);
+        nrfy_gpio_pin_clear(PDM_PWR_PIN);
+        LOG_ERR("PDM start failed: %d", err);
+        return;
+    }
+    LOG_INF("Audio microphone started for capture");
 }
