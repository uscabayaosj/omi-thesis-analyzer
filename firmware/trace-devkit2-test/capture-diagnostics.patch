 static struct bt_gatt_service audio_service = BT_GATT_SERVICE(audio_service_attr);
 
+atomic_t trace_stats[TRACE_STAT_COUNT];
+// v1: little-endian uint32 version, uptime-ms, then ten cumulative counters.
+// Snapshot fields are atomic individually, not one globally frozen instant.
+static ssize_t trace_stats_read(struct bt_conn *conn, const struct bt_gatt_attr *attr,
+                               void *buf, uint16_t len, uint16_t offset)
+{
+    uint8_t value[(2 + TRACE_STAT_COUNT) * 4];
+    sys_put_le32(1, value);
+    sys_put_le32(k_uptime_get_32(), value + 4);
+    for (int i = 0; i < TRACE_STAT_COUNT; i++)
+        sys_put_le32((uint32_t)atomic_get(&trace_stats[i]), value + 8 + i * 4);
+    return bt_gatt_attr_read(conn, attr, buf, len, offset, value, sizeof(value));
+}
+static struct bt_uuid_128 trace_stats_uuid =
+    BT_UUID_INIT_128(BT_UUID_128_ENCODE(0xA71C0002, 0x6B8D, 0x4E75, 0xA1B2, 0x7D0E6F545243));
+
