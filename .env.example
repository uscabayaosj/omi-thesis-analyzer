# Copy this file to .env.local and fill in the values you need.

# Production only (set in Vercel, never pulled locally): DEEPGRAM_API_KEY,
# CAPTURE_INGEST_TOKEN, and the Blob store the dashboard connects.

# Which AI provider to call: openai | anthropic | google | openrouter.
# Defaults to openai if unset.
AI_PROVIDER=openai

# Model override for the selected provider. Optional — each provider has a
# default (see src/lib/analysis.ts). Examples: gpt-5.6-luna, claude-sonnet-5,
# gemini-2.0-flash, deepseek/deepseek-v4.
AI_MODEL=

# Reasoning effort on GPT-5+ models only: none | low | medium | high | xhigh | max.
# Defaults to low. These calls extract structured fields against a fixed
# rubric and don't need deep deliberation — raise this if analysis quality
# suffers, most likely on the thesis-evidence path.
AI_REASONING_EFFORT=low

# Set only the key for the provider you're using.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Optional. Neon Postgres connection string for cross-device durability.
# Without it the app runs entirely on localStorage — nothing here is required
# for local development.
DATABASE_URL=

# Optional. Enables the "remind me if I forget today's rollup" push
# notification (requires DATABASE_URL above too, since subscriptions are
# stored in Neon). Without these, the app works fully — the reminder toggle
# just won't do anything.
#
# Generate a key pair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: URI — the Web Push protocol requires it, e.g.
# mailto:you@example.com
VAPID_SUBJECT=

# Same value as VAPID_PUBLIC_KEY above — duplicated because this one is
# inlined into the client bundle at BUILD time (NEXT_PUBLIC_ prefix). If you
# set this after an initial deploy, you must redeploy for it to take effect.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Required for the check-rollup cron route to accept requests. Vercel sends
# this automatically as `Authorization: Bearer $CRON_SECRET` on requests to
# a configured cron path — generate any random secret and set the same
# value here and in Vercel's project environment variables.
CRON_SECRET=
